datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id        Int        @id @default(autoincrement())
  name      String
  price     Float
  stock     Int
  movements Movement[] 
  orders    Order[]
}

model Movement {
  id        Int      @id @default(autoincrement())
  type      String  
  quantity  Int
  createdAt DateTime @default(now())

  productId Int
  // onDelete: Cascade
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model User {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  password         String
  
  // campos para a recuperação de senha
  resetCode        String?  
  resetCodeExpires DateTime? 
}

model Order {
  id           Int      @id @default(autoincrement())
  customerName String   // Nome do cliente
  quantity     Int      // Quantidade pedida
  status       String   // "Pendente" ou "Separado"
  createdAt    DateTime @default(now())
  
  productId    Int
  // onDelete: Cascade
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}